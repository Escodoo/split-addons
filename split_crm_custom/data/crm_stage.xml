<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="stage_intake_new" model="crm.stage">
        <field name="name">New</field>
        <field name="sequence">10</field>
        <field name="team_id" ref="crm_team_intake" />
        <field
            name="requirements"
        >Incoming contact from a scheduled meeting or a walk-in.</field>
    </record>
    <record id="stage_intake_qualify" model="crm.stage">
        <field name="name">To qualify</field>
        <field name="sequence">20</field>
        <field name="team_id" ref="crm_team_intake" />
        <field
            name="requirements"
        >Confirm company, contact and what was presented.</field>
    </record>
    <record id="stage_intake_nurture" model="crm.stage">
        <field name="name">Nurture</field>
        <field name="sequence">30</field>
        <field name="team_id" ref="crm_team_intake" />
        <field
            name="requirements"
        >No active deal. Keep history and schedule a follow-up.</field>
    </record>
    <record id="stage_intake_ready" model="crm.stage">
        <field name="name">Ready for sales</field>
        <field name="sequence">40</field>
        <field name="team_id" ref="crm_team_intake" />
        <field
            name="requirements"
        >Convert to an opportunity on Services or Intellectual Property.</field>
    </record>
    <record id="stage_intake_disqualified" model="crm.stage">
        <field name="name">Disqualified</field>
        <field name="sequence">90</field>
        <field name="fold" eval="True" />
        <field name="team_id" ref="crm_team_intake" />
    </record>
</odoo>
