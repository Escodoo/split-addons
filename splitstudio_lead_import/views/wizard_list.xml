<odoo>
    <record id="view_splitstudio_lead_import_wizard_tree" model="ir.ui.view">
        <field name="name">splitstudio.lead.import.wizard.tree</field>
        <field name="model">splitstudio.lead.import.wizard</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="user_id" widget="many2one_avatar_user" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'preview'"
                    decoration-success="state == 'done'"
                />
                <field name="file_name" optional="show" />
                <field name="create_date" optional="show" />
            </list>
        </field>
    </record>

    <record id="action_splitstudio_lead_import_sessions" model="ir.actions.act_window">
        <field name="name">Import Sessions</field>
        <field name="res_model">splitstudio.lead.import.wizard</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_splitstudio_lead_import_sessions"
        name="Import Sessions"
        parent="crm.crm_menu_root"
        action="action_splitstudio_lead_import_sessions"
        sequence="31"
    />
</odoo>
