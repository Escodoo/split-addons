                                    name="name"
                                    value="Newsletter signup"
                                />
                            </div>
                            <div class="s_website_form_field s_website_form_dnone">
                                <input
                                    type="hidden"
                                    class="form-control s_website_form_input"
                                    name="team_id"
                                    value="*crm_team_intake*"
                                />
                            </div>
                            <div
                                class="mb-0 col-12 s_website_form_submit s_website_form_no_submit_label"
                                data-name="Submit Button"
                            >
                                <a
                                    href="#"
                                    role="button"
                                    class="btn acd-form-send s_website_form_send"
                                >Send</a>
                                <span id="academia_newsletter_result" />
                            </div>
                        </div>
                    </form>
                </section>
            </t>
        </field>
    </record>
</odoo>
