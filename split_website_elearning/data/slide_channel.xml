<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="slide_channel_backgrounds" model="slide.channel">
        <field name="name">The Art of Creating Backgrounds</field>
        <field name="user_id" ref="base.user_admin" />
        <field name="website_id" ref="website_academia" />
        <field name="channel_type">training</field>
        <field name="enroll">public</field>
        <field name="visibility">public</field>
        <field name="allow_comment" eval="True" />
        <field name="promote_strategy">latest</field>
        <field name="is_published" eval="True" />
        <field
            name="image_1920"
            type="base64"
            file="split_website_elearning/static/src/img/channel_backgrounds.png"
        />
        <field
            name="description"
        >This course is the gateway to background design in animation. You will learn specific techniques and the principles that turn a simple setting into an essential piece of visual storytelling.</field>
        <field
            name="tag_ids"
            eval="[(6, 0, [
                ref('slide_channel_tag_type_course'),
                ref('website_slides.slide_channel_tag_level_basic'),
                ref('slide_channel_tag_skill_photoshop'),
                ref('slide_channel_tag_language_portuguese'),
            ])]"
        />
    </record>
