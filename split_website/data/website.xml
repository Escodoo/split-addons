<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="website.default_website" model="website">
        <field name="name">Split Studio</field>
        <field
            name="logo"
            type="base64"
            file="split_website/static/src/binary/ir_attachment/brand_logo_png.png"
        />
        <field
            name="favicon"
            type="base64"
            file="split_website/static/src/binary/ir_attachment/brand_favicon.png"
        />
        <field name="social_facebook">https://www.facebook.com/SplitFilmes/</field>
        <field name="social_instagram">https://www.instagram.com/splitstudiobr/</field>
        <field name="social_youtube">https://www.youtube.com/c/SplitStudioBR</field>
        <field
            name="social_linkedin"
        >https://br.linkedin.com/company/splitstudio</field>
        <field name="social_twitter" />
        <field name="social_tiktok" />
    </record>
    <record id="mailing_list_newsletter" model="mailing.list">
        <field name="name">Split Studio Newsletter</field>
        <field name="is_public" eval="True" />
    </record>
</odoo>
