                                                <p
                                                    class="lead mb-0"
                                                >Series, films, promos and branded content.</p>
                                            </div>
                                            <p class="mb-0">
                                                <a href="/contactus">Start a project <i
                                                    class="fa fa-long-arrow-right ms-2"
                                                /></a>
                                            </p>
                                        </div>
                                    </div>
                                    <input
                                        type="radio"
                                        name="split_work_cat"
                                        id="split_work_all"
                                        checked="checked"
                                    />
                                    <label for="split_work_all">All</label>
                                    <input
                                        type="radio"
                                        name="split_work_cat"
                                        id="split_work_shows"
                                    />
                                    <label for="split_work_shows">Shows</label>
                                    <input
                                        type="radio"
                                        name="split_work_cat"
