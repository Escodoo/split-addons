<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="contactus" model="ir.ui.view">
        <field name="name">Split Studio - Contact Us</field>
        <field name="key">split_website.contactus</field>
        <field name="type">qweb</field>
        <field name="website_id" ref="website.default_website" />
        <field name="active" eval="True" />
        <field name="arch" type="xml">
            <t name="Contact Us" t-name="website.contactus">
                <t t-call="website.layout">
                    <t
                        t-set="logged_partner"
                        t-value="request.env['website.visitor']._get_visitor_from_request().partner_id"
                    />
                    <t
                        t-set="contactus_form_values"
                        t-value="{
                        'contact_name': request.params.get('contact_name', ''),
                        'partner_name': request.params.get('partner_name', ''),
                        'phone': request.params.get('phone', ''),
                        'email_from': request.params.get('email_from', ''),
                        'description': request.params.get('description', ''),
                    }"
                    />
                    <span
                        class="hidden"
                        data-for="contactus_form"
                        t-att-data-values="contactus_form_values"
                    />
                    <div id="wrap">
                        <div
                            id="oe_structure_split_website_contactus"
                            class="oe_structure"
                        >
                            <section
                                class="s_title parallax s_parallax_is_fixed pt96 pb96 o_cc o_cc5"
                                data-vcss="001"
                                data-snippet="s_title"
                                data-name="Title"
                                data-scroll-background-ratio="1"
                            >
                                <span
                                    class="s_parallax_bg oe_img_bg o_bg_img_center"
                                    style="background-image: url('/web/image/split_website.banner_hello_kitty');"
                                />
                                <div class="o_we_bg_filter bg-black-75" />
                                <div class="container">
                                    <h1 class="display-2-fs">Talk to us</h1>
                                    <p
                                        class="lead mb-0"
                                    >Tell us about your project, your studio or the story you want to animate.</p>
                                </div>
                            </section>
                            <section
                                class="s_text_block pt48 pb64 o_cc o_cc5"
                                data-snippet="s_text_block"
                                data-name="Contact"
                            >
                                <div class="container s_allow_columns">
                                    <div class="row">
                                        <div class="col-lg-7">
                                            <section
                                                class="s_website_form"
                                                data-vcss="001"
                                                data-snippet="s_website_form"
                                                data-name="Form"
                                            >
                                                <div class="container">
                                                    <form
                                                        id="contactus_form"
                                                        action="/website/form/"
                                                        method="post"
                                                        enctype="multipart/form-data"
                                                        class="o_mark_required"
                                                        data-mark="*"
                                                        data-model_name="crm.lead"
                                                        data-success-mode="redirect"
                                                        data-success-page="/contactus-thank-you"
                                                        data-pre-fill="true"
                                                    >
                                                        <div
                                                            class="s_website_form_rows row s_col_no_bgcolor"
                                                        >
                                                            <div
                                                                class="mb-3 col-lg-6 s_website_form_field s_website_form_required s_website_form_model_required"
                                                                data-type="char"
                                                                data-name="Field"
                                                            >
                                                                <label
                                                                    class="s_website_form_label"
                                                                    for="split_contact_name"
                                                                >
                                                                    <span
                                                                        class="s_website_form_label_content"
                                                                    >Name</span>
                                                                    <span
                                                                        class="s_website_form_mark"
                                                                    > *</span>
                                                                </label>
                                                                <input
                                                                    id="split_contact_name"
                                                                    type="text"
                                                                    class="form-control s_website_form_input"
                                                                    name="contact_name"
                                                                    required=""
                                                                    data-fill-with="name"
                                                                />
                                                            </div>
                                                            <div
                                                                class="mb-3 col-lg-6 s_website_form_field s_website_form_required s_website_form_model_required"
                                                                data-type="email"
                                                                data-name="Field"
                                                            >
                                                                <label
                                                                    class="s_website_form_label"
                                                                    for="split_contact_email"
                                                                >
                                                                    <span
                                                                        class="s_website_form_label_content"
                                                                    >E-mail</span>
                                                                    <span
                                                                        class="s_website_form_mark"
                                                                    > *</span>
                                                                </label>
                                                                <input
                                                                    id="split_contact_email"
                                                                    type="email"
                                                                    class="form-control s_website_form_input"
                                                                    name="email_from"
                                                                    required=""
                                                                    data-fill-with="email"
                                                                />
                                                            </div>
                                                            <div
                                                                class="mb-3 col-lg-6 s_website_form_field"
                                                                data-type="char"
                                                                data-name="Field"
                                                            >
                                                                <label
                                                                    class="s_website_form_label"
                                                                    for="split_contact_company"
                                                                >
                                                                    <span
                                                                        class="s_website_form_label_content"
                                                                    >Company</span>
                                                                </label>
                                                                <input
                                                                    id="split_contact_company"
                                                                    type="text"
                                                                    class="form-control s_website_form_input"
                                                                    name="partner_name"
                                                                    data-fill-with="commercial_company_name"
                                                                />
                                                            </div>
                                                            <div
                                                                class="mb-3 col-lg-6 s_website_form_field"
                                                                data-type="char"
                                                                data-name="Field"
                                                            >
                                                                <label
                                                                    class="s_website_form_label"
                                                                    for="split_contact_phone"
                                                                >
                                                                    <span
                                                                        class="s_website_form_label_content"
                                                                    >Phone</span>
                                                                </label>
                                                                <input
                                                                    id="split_contact_phone"
                                                                    type="tel"
                                                                    class="form-control s_website_form_input"
                                                                    name="phone"
                                                                    data-fill-with="phone"
                                                                />
                                                            </div>
                                                            <div
                                                                class="mb-3 col-lg-6 s_website_form_field s_website_form_required s_website_form_model_required"
                                                                data-type="selection"
                                                                data-name="Field"
                                                            >
                                                                <label
                                                                    class="s_website_form_label"
                                                                    for="split_contact_subject"
                                                                >
                                                                    <span
                                                                        class="s_website_form_label_content"
                                                                    >Select the subject</span>
                                                                    <span
                                                                        class="s_website_form_mark"
                                                                    > *</span>
                                                                </label>
                                                                <select
                                                                    id="split_contact_subject"
                                                                    class="form-select s_website_form_input"
                                                                    name="name"
                                                                    required=""
                                                                >
                                                                    <option value="" />
                                                                    <option
                                                                        value="Bids"
                                                                    >Bids</option>
                                                                    <option
                                                                        value="Work with Split"
                                                                    >Work with Split</option>
                                                                    <option
                                                                        value="Press"
                                                                    >Press</option>
                                                                    <option
                                                                        value="Other"
                                                                    >Other</option>
                                                                </select>
                                                            </div>
                                                            <div
                                                                class="mb-3 col-lg-6 s_website_form_field s_website_form_custom"
                                                                data-type="selection"
                                                                data-name="Field"
                                                            >
                                                                <label
                                                                    class="s_website_form_label"
                                                                    for="split_contact_field"
                                                                >
                                                                    <span
                                                                        class="s_website_form_label_content"
                                                                    >Select your field of work</span>
                                                                </label>
                                                                <select
                                                                    id="split_contact_field"
                                                                    class="form-select s_website_form_input"
                                                                    name="Field of work"
                                                                >
                                                                    <option value="" />
                                                                    <option
                                                                        value="Animation"
                                                                    >Animation</option>
                                                                    <option
                                                                        value="Illustration"
                                                                    >Illustration</option>
                                                                    <option
                                                                        value="Storyboard"
                                                                    >Storyboard</option>
                                                                    <option
                                                                        value="Script Writing"
                                                                    >Script Writing</option>
                                                                    <option
                                                                        value="Production"
                                                                    >Production</option>
                                                                    <option
                                                                        value="Other"
                                                                    >Other</option>
                                                                </select>
                                                            </div>
                                                            <div
                                                                class="mb-3 col-12 s_website_form_field s_website_form_custom"
                                                                data-type="char"
                                                                data-name="Field"
                                                            >
                                                                <label
                                                                    class="s_website_form_label"
                                                                    for="split_contact_portfolio"
                                                                >
                                                                    <span
                                                                        class="s_website_form_label_content"
                                                                    >Link to portfolio</span>
                                                                </label>
                                                                <input
                                                                    id="split_contact_portfolio"
                                                                    type="url"
                                                                    class="form-control s_website_form_input"
                                                                    name="Portfolio"
                                                                />
                                                            </div>
                                                            <div
                                                                class="mb-3 col-12 s_website_form_field s_website_form_required s_website_form_model_required"
                                                                data-type="text"
                                                                data-name="Field"
                                                            >
                                                                <label
                                                                    class="s_website_form_label"
                                                                    for="split_contact_message"
                                                                >
                                                                    <span
                                                                        class="s_website_form_label_content"
                                                                    >Message</span>
                                                                    <span
                                                                        class="s_website_form_mark"
                                                                    > *</span>
                                                                </label>
                                                                <textarea
                                                                    id="split_contact_message"
                                                                    class="form-control s_website_form_input"
                                                                    name="description"
                                                                    required=""
                                                                    rows="6"
                                                                />
                                                            </div>
                                                            <div
                                                                class="mb-3 col-12 s_website_form_field s_website_form_dnone"
                                                            >
                                                                <div
                                                                    class="row s_col_no_resize s_col_no_bgcolor"
                                                                >
                                                                    <label
                                                                        class="col-form-label col-sm-auto s_website_form_label"
                                                                        for="split_contact_team"
                                                                    >
                                                                        <span
                                                                            class="s_website_form_label_content"
                                                                        >Sales Team</span>
                                                                    </label>
                                                                    <div class="col-sm">
                                                                        <input
                                                                            id="split_contact_team"
                                                                            type="hidden"
                                                                            class="form-control s_website_form_input"
                                                                            name="team_id"
                                                                            value="*crm_team_intake*"
                                                                        />
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div
                                                                class="mb-3 col-12 s_website_form_field s_website_form_dnone"
                                                            >
                                                                <div
                                                                    class="row s_col_no_resize s_col_no_bgcolor"
                                                                >
                                                                    <label
                                                                        class="col-form-label col-sm-auto s_website_form_label"
                                                                        for="split_contact_medium"
                                                                    >
                                                                        <span
                                                                            class="s_website_form_label_content"
                                                                        >Medium</span>
                                                                    </label>
                                                                    <div class="col-sm">
                                                                        <input
                                                                            id="split_contact_medium"
                                                                            type="hidden"
                                                                            class="form-control s_website_form_input"
                                                                            name="medium_id"
                                                                            value="*utm_medium_website*"
                                                                        />
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div
                                                                class="mb-0 py-2 col-12 s_website_form_submit s_website_form_no_submit_label"
                                                                data-name="Submit Button"
                                                            >
                                                                <div
                                                                    style="width: 200px;"
                                                                    class="s_website_form_label"
                                                                />
                                                                <a
                                                                    href="#"
                                                                    role="button"
                                                                    class="btn btn-primary btn-lg s_website_form_send"
                                                                >Send</a>
                                                                <span
                                                                    id="s_website_form_result"
                                                                />
                                                            </div>
                                                        </div>
                                                    </form>
                                                </div>
                                            </section>
                                        </div>
                                        <div class="col-lg-4 offset-lg-1 mt-4 mt-lg-0">
                                            <h5>Brazil</h5>
                                            <ul class="list-unstyled mb-4 ps-2">
                                                <li>
                                                    <i class="fa fa-phone fa-fw me-2" />
                                                    <span
                                                        class="o_force_ltr"
                                                    >+55 (11) 91366 8953</span>
                                                </li>
                                                <li>
                                                    <i
                                                        class="fa fa-map-marker fa-fw me-2"
                                                    />
                                                    <span
                                                    >São Paulo - SP &amp; Rio de Janeiro - RJ</span>
                                                </li>
                                            </ul>
                                            <h5>USA</h5>
                                            <ul class="list-unstyled mb-4 ps-2">
                                                <li>
                                                    <i class="fa fa-phone fa-fw me-2" />
                                                    <span
                                                        class="o_force_ltr"
                                                    >+1 (682) 862 6656</span>
                                                </li>
                                                <li>
                                                    <i
                                                        class="fa fa-map-marker fa-fw me-2"
                                                    />
                                                    <span>Dallas - TX</span>
                                                </li>
                                            </ul>
                                            <ul class="list-unstyled mb-0 ps-2">
                                                <li>
                                                    <i class="fa fa-vimeo fa-fw me-2" />
                                                    <a
                                                        href="https://vimeo.com/splitstudio"
                                                        target="_blank"
                                                    >vimeo.com/splitstudio</a>
                                                </li>
                                                <li>
                                                    <i
                                                        class="fa fa-youtube-play fa-fw me-2"
                                                    />
                                                    <a
                                                        href="https://www.youtube.com/c/SplitStudioBR"
                                                        target="_blank"
                                                    >YouTube</a>
                                                </li>
                                                <li>
                                                    <i
                                                        class="fa fa-instagram fa-fw me-2"
                                                    />
                                                    <a
                                                        href="https://www.instagram.com/splitstudiobr/"
                                                        target="_blank"
                                                    >@splitstudiobr</a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </section>
                        </div>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
