<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- The official studio site has no Odoo promotion in the copyright bar. -->
    <template
        id="hide_brand_promotion"
        inherit_id="web.brand_promotion"
        name="Hide Odoo brand promotion"
        priority="99"
    >
        <xpath expr="//div[hasclass('o_brand_promotion')]" position="replace">
            <div class="o_brand_promotion d-none" />
        </xpath>
    </template>
    <template
        id="footer_newsletter"
        inherit_id="website.layout"
        name="Split footer newsletter"
        priority="20"
    >
        <xpath expr="//div[@id='footer']" position="before">
            <section class="o_cc o_cc5 pt48 pb32" data-name="Newsletter">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-lg-6 pb16 pb-lg-0">
                            <h2 class="h4-fs mb-2">Sign up for our newsletter</h2>
                            <p class="mb-0">
                                Productions, original IPs and studio news, straight to
                                your inbox.
                            </p>
                        </div>
                        <div class="col-lg-5 offset-lg-1">
                            <div class="s_website_form" data-vcss="001">
                                <form
                                    action="/website/form/"
                                    method="post"
                                    enctype="multipart/form-data"
                                    class="o_mark_required"
                                    data-mark="*"
                                    data-model_name="mailing.contact"
                                    data-success-mode="message"
                                >
                                    <div class="s_website_form_rows row s_col_no_bgcolor">
                                        <div
                                            class="mb-2 col-12 s_website_form_field s_website_form_required s_website_form_model_required"
                                            data-type="char"
                                        >
                                            <input
                                                type="text"
                                                class="form-control s_website_form_input"
                                                name="name"
                                                required=""
                                                placeholder="Your name"
                                            />
                                        </div>
                                        <div
                                            class="mb-0 col-12 s_website_form_field s_website_form_required s_website_form_model_required"
                                            data-type="email"
                                        >
                                            <div class="input-group">
                                                <input
                                                    type="email"
                                                    class="form-control s_website_form_input"
                                                    name="email"
                                                    required=""
                                                    placeholder="you@example.com"
                                                />
                                                <a
                                                    href="#"
                                                    role="button"
                                                    class="btn btn-primary s_website_form_send"
                                                >Subscribe</a>
                                            </div>
                                        </div>
                                        <div
                                            class="s_website_form_field s_website_form_dnone"
                                            data-type="char"
                                        >
                                            <input
                                                type="hidden"
                                                class="s_website_form_input"
                                                name="list_ids"
                                                t-att-value="request.env.ref('split_website.mailing_list_newsletter').id"
                                            />
                                        </div>
                                    </div>
                                    <span id="s_website_form_result" />
                                </form>
                            </div>
                            <p class="o_small mt-3 mb-0">
                                <a
                                    href="https://vimeo.com/splitstudio"
                                    target="_blank"
                                >Vimeo</a>
                                ·
                                <a href="/privacy">Privacy</a>
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
    <template
        id="footer_mascot"
        inherit_id="website.layout"
        name="Split footer mascot"
        priority="25"
    >
        <xpath expr="//footer[@id='bottom']" position="inside">
            <div class="split-footer-mascot" aria-hidden="true">
                <video
                    src="/split_website/static/src/video/footer_character_01.mp4"
                    muted="muted"
                    playsinline="playsinline"
                    preload="metadata"
                />
            </div>
        </xpath>
    </template>
</odoo>
