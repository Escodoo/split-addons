<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- The official studio site has no Odoo promotion in the copyright bar. -->
    <template
        id="hide_brand_promotion"
        inherit_id="web.brand_promotion"
        name="Hide Odoo brand promotion"
        priority="99"
    >
        <xpath expr="//div[hasclass('o_brand_promotion')]" position="replace">
            <div class="o_brand_promotion d-none" />
        </xpath>
    </template>
    <template
        id="footer_newsletter"
        inherit_id="website.layout"
        name="Split footer newsletter"
        priority="20"
    >
        <xpath expr="//div[@id='footer']" position="before">
            <section
                class="s_newsletter_block s_newsletter_list o_cc o_cc5 pt48 pb32"
                data-snippet="s_newsletter_block"
                data-name="Newsletter"
            >
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-lg-6 pb16 pb-lg-0">
                            <h2 class="h4-fs mb-2">Sign up for our newsletter</h2>
                            <p class="mb-0">
                                Productions, original IPs and studio news, straight to
                                your inbox.
                            </p>
                        </div>
                        <div class="col-lg-5 offset-lg-1">
                            <div
                                class="s_newsletter_subscribe_form s_newsletter_list js_subscribe"
                                data-vxml="001"
                                t-att-data-list-id="request.env.ref('split_website.mailing_list_newsletter').id"
                                data-name="Newsletter Form"
                            >
                                <div class="js_subscribed_wrap d-none">
                                    <p class="h4-fs text-center text-success mb-0">
                                        <i class="fa fa-check-circle-o" role="img" />
                                        Thanks for registering!
                                    </p>
                                </div>
                                <div class="js_subscribe_wrap">
                                    <div class="input-group">
                                        <input
                                            type="email"
                                            name="email"
                                            class="js_subscribe_value form-control"
                                            placeholder="you@example.com"
                                        />
                                        <a
                                            role="button"
                                            href="#"
                                            class="btn btn-primary js_subscribe_btn o_submit"
                                        >Subscribe</a>
                                    </div>
                                </div>
                            </div>
                            <p class="o_small mt-3 mb-0">
                                <a
                                    href="https://vimeo.com/splitstudio"
                                    target="_blank"
                                >Vimeo</a>
                                ·
                                <a href="/privacy">Privacy</a>
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
</odoo>
