#. module: split_website
#: model_terms:ir.ui.view,arch_db:split_website.about
msgid ""
"Cid is an Executive Producer and\n"
"                                                Animation Director with more than 15\n"
"                                                years of experience across TV series,\n"
"                                                feature films, short films and other\n"
"                                                formats. At Split, he carries the\n"
"                                                production torch and leads the teams\n"
"                                                toward innovation, quality and\n"
"                                                top-notch delivery."
msgstr ""
